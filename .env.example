# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks

# Application Configuration
NEXT_PUBLIC_APP_NAME="SD Negeri Sumber Waru 2"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sekolah.local

# Storage Configuration
NEXT_PUBLIC_STORAGE_BUCKET_PUBLIC=situs-public
NEXT_PUBLIC_STORAGE_BUCKET_PRIVATE=situs-private